      '<path d="M140 47L180 39" stroke="#e8fbff" stroke-width="2.5" stroke-linecap="round"/></g></svg>',
    // Golden Blade Dancer – blonde ponytail, purple and gold, a huge curved sword
    dancer: '<svg viewBox="0 0 160 140"><ellipse cx="80" cy="134" rx="36" ry="4" fill="rgba(0,0,0,.16)"/>' +
      '<g class="sb-after"><path d="M50 30C62 26 72 34 70 46L74 88L58 120L48 118L56 88L46 60Z" fill="#9b6bff"/></g>' +
      '<path d="M84 24C70 16 52 20 40 32C30 42 20 46 6 44C20 58 44 56 58 46C66 40 74 38 84 36Z" fill="#ffcf3f"/>' +
      '<path d="M82 28C68 26 54 32 44 42" stroke="#e09b00" stroke-width="2" fill="none"/>' +
      SB_LEGS('#2a1840', '#f2b705') +
      '<path d="M70 60L42 86L66 84Z" fill="#3f1c63"/><path d="M70 56H94L100 90L66 92Z" fill="#5b2a86"/>' +
      '<path d="M66 92L100 90" stroke="#f2b705" stroke-width="3"/><path d="M72 42H92L94 62H70Z" fill="#7b3fb5"/><path d="M74 42H90L82 51Z" fill="#f2b705"/>' +
      '<path d="M74 46L64 58L70 64" stroke="' + SKIN + '" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>' +
      '<circle cx="86" cy="28" r="11" fill="' + SKIN + '"/><path d="M75 28C76 13 97 11 100 26C93 21 85 21 78 34Z" fill="#ffd54a"/>' +
      '<path d="M91 29H95" stroke="#3b2a5c" stroke-width="2" stroke-linecap="round"/>' +
      '<path d="M90 46L104 54L114 60" stroke="' + SKIN + '" stroke-width="5" stroke-linecap="round" fill="none"/>' +
      '<path d="M114 60C131 72 147 97 151 129C141 104 127 85 110 67Z" fill="#e6efff"/>' +
      '<path d="M114 60C131 72 147 97 151 129" stroke="#9fd8ff" stroke-width="2.5" fill="none"/><path d="M107 55L119 64" stroke="#f2b705" stroke-width="4" stroke-linecap="round"/>' +
      '<path class="sb-slash" style="transform-origin:114px 60px" d="M122 16C158 38 162 90 132 122" stroke="#ffd36b" stroke-width="5" fill="none" stroke-linecap="round"/></svg>',
    // Storm Mage – hooded, floating, crystal staff, lightning and sparks
    mage: '<svg viewBox="0 0 160 140"><ellipse cx="72" cy="136" rx="26" ry="3" fill="rgba(0,0,0,.12)"/>' +
      '<path d="M70 40C58 70 46 100 28 124C54 118 76 122 102 128C96 100 94 70 92 44Z" fill="#33256e"/>' +
      '<path d="M74 50C66 76 60 100 52 118C66 116 80 118 94 122C92 96 90 72 88 50Z" fill="#5e45b8"/>' +
      '<path d="M76 52L86 52L84 88" stroke="#7fe3ff" stroke-width="2" fill="none" opacity=".8"/>' +
      '<circle cx="82" cy="30" r="11" fill="' + SKIN + '"/><path d="M67 36C64 16 80 6 93 11C102 15 104 27 99 38C95 27 85 22 74 30Z" fill="#2c1f5e"/>' +
      '<path d="M88 18C97 23 100 34 96 46" stroke="#bfe9ff" stroke-width="3" fill="none" stroke-linecap="round"/><path d="M84 31H88" stroke="#7fe3ff" stroke-width="2.5" stroke-linecap="round"/>' +
      '<path d="M90 50L106 54" stroke="' + SKIN + '" stroke-width="5" stroke-linecap="round"/>' +
      '<path d="M108 20L100 114" stroke="#6b4a2a" stroke-width="4" stroke-linecap="round"/>' +
      '<circle cx="109" cy="16" r="10" fill="#7fe3ff" opacity=".35"/><circle cx="109" cy="16" r="5" fill="#dffaff"/>' +
      '<g class="sb-bolt"><path d="M114 16L132 8L127 21L148 10L141 27L162 18" stroke="#7fe3ff" stroke-width="8" opacity=".35" fill="none" stroke-linejoin="round"/>' +
      '<path d="M114 16L132 8L127 21L148 10L141 27L162 18" stroke="#e8fbff" stroke-width="2.5" fill="none" stroke-linejoin="round"/></g>' +
      '<g fill="#bff4ff"><circle class="sb-spark" cx="62" cy="112" r="2.2"/><circle class="sb-spark" cx="80" cy="120" r="1.8" style="animation-delay:-.8s"/>' +
      '<circle class="sb-spark" cx="96" cy="108" r="2" style="animation-delay:-1.5s"/><circle class="sb-spark" cx="48" cy="100" r="1.6" style="animation-delay:-2.1s"/></g></svg>',
    // Azure Knight – white hair, dark armour, red scarf, two glowing blades
    knight: '<svg viewBox="0 0 160 140"><ellipse cx="80" cy="134" rx="34" ry="4" fill="rgba(0,0,0,.16)"/>' +
      '<g class="sb-speed" stroke="#7fe3ff" stroke-width="3" stroke-linecap="round"><path d="M4 50H26M0 64H22M8 78H28"/></g>' +
      '<path d="M80 40C64 38 48 46 28 42C42 56 62 54 78 48Z" fill="#d23c3c"/>' +
      '<path d="M74 46L62 56" stroke="#1f2a4d" stroke-width="7" stroke-linecap="round"/>' +
      '<path d="M62 56L28 72" stroke="#7fe3ff" stroke-width="9" opacity=".3" stroke-linecap="round"/><path d="M62 56L28 72" stroke="#dffaff" stroke-width="3" stroke-linecap="round"/>' +
      '<path d="M77 68L78 90M89 68L85 90" stroke="#1f2a4d" stroke-width="9" stroke-linecap="round"/>' + SB_LEGS('#1f2a4d', '#0f1630') +
      '<path d="M71 40H95L97 70H69Z" fill="#26345e"/><path d="M80 46H87L83.5 60Z" fill="#7fe3ff"/>' +
      '<path d="M86 38C96 35 103 42 101 49H88Z" fill="#3a4b80"/><rect x="69" y="64" width="28" height="5" fill="#c9a227"/>' +
      '<circle cx="84" cy="27" r="10" fill="' + SKIN + '"/>' +
      '<path d="M73 27L69 14L78 19L79 7L86 16L93 7L94 18L101 14L96 27C90 21 80 21 73 27Z" fill="#eef3ff"/>' +
      '<path d="M88 28H92" stroke="#2f6fd0" stroke-width="2.2" stroke-linecap="round"/>' +
      '<path d="M92 46L106 56" stroke="#1f2a4d" stroke-width="7" stroke-linecap="round"/>' +
      '<path d="M106 56L148 38" stroke="#7fe3ff" stroke-width="10" opacity=".3" stroke-linecap="round"/><path d="M106 56L148 38" stroke="#e8fbff" stroke-width="3.5" stroke-linecap="round"/>' +
      '<path d="M103 51L109 60" stroke="#c9a227" stroke-width="3" stroke-linecap="round"/></svg>'
  };
  // A runner with a real stride: thighs, knees and arms swing (CSS); shirt in the category colour, with a bib.
  var SB_RUNNER = function (shirt, shorts, skin, top, bib) {
    var limb = function (cls, origin, d, color, w) {
      return '<g class="' + cls + '" style="transform-origin:' + origin + '"><path d="' + d + '" stroke="' + color + '" stroke-width="' + w + '" stroke-linecap="round" stroke-linejoin="round" fill="none"/>';
    };
    var leg = function (side) {
      return limb('rn-thigh ' + side, '48px 66px', 'M48 66L48 88', shorts, 9) +
        limb('rn-shin ' + side, '48px 88px', 'M48 88L48 107', skin, 7) +
        '<path d="M45 108L58 109" stroke="#222" stroke-width="6" stroke-linecap="round"/></g></g>';
    };
    var arm = function (side) { return limb('rn-arm ' + side, '52px 38px', 'M52 38L52 55L61 62', skin, 6) + '</g>'; };
    return '<svg viewBox="0 0 100 120"><ellipse cx="50" cy="116" rx="22" ry="3" fill="rgba(0,0,0,.16)"/><g class="rn-body">' +
      arm('rn-b') + leg('rn-b') +
      '<path d="M42 34C44 30 58 30 60 34L58 66H42Z" fill="' + shirt + '"/><path d="M41 62H59L60 74H40Z" fill="' + shorts + '"/>' +
      '<rect x="44.5" y="42" width="13" height="10" rx="1.5" fill="#fff"/>' +
      '<text x="51" y="49.5" font-size="' + (bib.length > 4 ? 4.6 : 6) + '" font-weight="800" text-anchor="middle" fill="#111" font-family="Arial,sans-serif">' + bib + '</text>' +
      '<circle cx="55" cy="21" r="9" fill="' + skin + '"/>' + top + leg('') + arm('') + '</g></svg>';
  };
  var CAP = function (c) { return '<path d="M46 19C46 10 62 8 64 16L71 18L64 20Z" fill="' + c + '"/>'; };
  var PONY = function (c) { return '<path d="M47 20C46 11 62 9 64 18C58 15 52 16 48 22Z" fill="' + c + '"/><path d="M47 18C40 18 36 24 33 30C39 28 43 25 47 23Z" fill="' + c + '"/>'; };
  var SB_SVG = {
    bb: '<svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="46" fill="#ef7d2d"/><g fill="none" stroke="#5b2a0e" stroke-width="3">' +
      '<path d="M50 4V96M4 50H96M18 16C33 31 33 69 18 84M82 16C67 31 67 69 82 84"/></g>' +
      '<circle cx="50" cy="50" r="46" fill="url(#sbg-shade)"/><circle cx="50" cy="50" r="46" fill="none" stroke="#5b2a0e" stroke-width="2.5"/></svg>',
    vb: '<svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="46" fill="#fffdf6"/><g clip-path="url(#sbg-clip)" fill="none">' +
      [['#f4c20d', 0], ['#2f6fd0', 120], ['#fffdf6', 240]].map(function (x) {
        return '<g transform="rotate(' + x[1] + ' 50 50)"><path d="M50 50C38 36 40 16 58 2" stroke="#24406f" stroke-width="17"/>' +
          '<path d="M50 50C38 36 40 16 58 2" stroke="' + x[0] + '" stroke-width="13"/></g>';
      }).join('') + '</g><circle cx="50" cy="50" r="46" fill="url(#sbg-shade)"/><circle cx="50" cy="50" r="46" fill="none" stroke="#24406f" stroke-width="2.5"/></svg>',
    pb: '<svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="46" fill="#d6ea3c"/><g fill="#9fb21d"><circle cx="50" cy="50" r="5"/>' +
      '<circle cx="72" cy="50" r="4.4"/><circle cx="61" cy="69.1" r="4.4"/><circle cx="39" cy="69.1" r="4.4"/><circle cx="28" cy="50" r="4.4"/><circle cx="39" cy="30.9" r="4.4"/><circle cx="61" cy="30.9" r="4.4"/>' +
      '<circle cx="85.2" cy="61.4" r="3.2"/><circle cx="71.7" cy="79.9" r="3.2"/><circle cx="50" cy="87" r="3.2"/><circle cx="28.3" cy="79.9" r="3.2"/><circle cx="14.8" cy="61.4" r="3.2"/>' +
      '<circle cx="14.8" cy="38.6" r="3.2"/><circle cx="28.3" cy="20.1" r="3.2"/><circle cx="50" cy="13" r="3.2"/><circle cx="71.7" cy="20.1" r="3.2"/><circle cx="85.2" cy="38.6" r="3.2"/></g>' +
      '<circle cx="50" cy="50" r="46" fill="url(#sbg-shade)"/><circle cx="50" cy="50" r="46" fill="none" stroke="#8fa31a" stroke-width="2"/></svg>',
    archer: SB_HEROES.archer, dancer: SB_HEROES.dancer, mage: SB_HEROES.mage, knight: SB_HEROES.knight,
    run5: SB_RUNNER('#2e7d32', '#1d2b1e', '#e8b996', CAP('#f2b705'), '5012'),
    run8: SB_RUNNER('#2f5fb3', '#1b2440', '#c98e6a', PONY('#2b1a12'), '8007'),
    run12: SB_RUNNER('#c62828', '#2b1414', '#f0c9a8', CAP('#ffffff'), '12021'),
    run5b: SB_RUNNER('#2e7d32', '#24302a', '#a8714f', PONY('#1a1a1a'), '5033')
  };
  var SB_DEFS = '<svg width="0" height="0" style="position:absolute"><defs>' +
    '<radialGradient id="sbg-shade" cx="35%" cy="30%" r="75%"><stop offset="0" stop-color="#fff" stop-opacity=".55"/>' +
    '<stop offset=".45" stop-color="#fff" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".28"/></radialGradient>' +
    '<clipPath id="sbg-clip"><circle cx="50" cy="50" r="46"/></clipPath></defs></svg>';
  // per page: kind, top (% of the screen), size (px), across time (s), start offset (s), bounce height (px), bounce time, spin time…
  var SPORT_BG = {
    basketball: [{ k: 'bb', t: 16, s: 74, d: 17, dl: -4, b: 150, bd: 1.35, sp: 2.4 }, { k: 'bb', t: 46, s: 50, d: 23, dl: -13, b: 110, bd: 1.1, sp: 1.8, r: 1 },
      { k: 'bb', t: 72, s: 92, d: 20, dl: -9, b: 170, bd: 1.5, sp: 2.8 }],
    volleyball: [{ k: 'vb', t: 22, s: 66, d: 19, dl: -6, b: 140, bd: 2.6, sp: 6, arc: 1 }, { k: 'vb', t: 52, s: 46, d: 25, dl: -15, b: 90, bd: 2.1, sp: 5, arc: 1, r: 1 },
      { k: 'vb', t: 76, s: 84, d: 22, dl: -2, b: 160, bd: 3, sp: 7, arc: 1 }],
    pickleball: [{ k: 'pb', t: 30, s: 50, rally: 1, d: 2.6, dl: 0, b: 120, sp: 1.2 }, { k: 'pb', t: 62, s: 42, rally: 1, d: 3.1, dl: -1.4, b: 90, sp: 1 },
      { k: 'pb', t: 84, s: 56, d: 15, dl: -5, b: 70, bd: 0.9, sp: 1.4 }],
    mlbb: [{ k: 'archer', t: 12, s: 190, d: 18, dl: -5 }, { k: 'dancer', t: 40, s: 200, d: 11, dl: -2, r: 1 },
      { k: 'mage', t: 58, s: 180, d: 26, dl: -16, b: 26, bd: 2.6 }, { k: 'knight', t: 76, s: 190, d: 13, dl: -8 }],
    funrun: [{ k: 'run5', t: 70, s: 92, d: 15, dl: -3 }, { k: 'run8', t: 74, s: 84, d: 18, dl: -11 }, { k: 'run12', t: 78, s: 100, d: 13, dl: -8 },
      { k: 'run5b', t: 30, s: 70, d: 21, dl: -14 }],
    home: [{ k: 'bb', t: 24, s: 58, d: 21, dl: -5, b: 120, bd: 1.3, sp: 2.2 }, { k: 'vb', t: 50, s: 54, d: 24, dl: -14, b: 110, bd: 2.4, sp: 6, arc: 1, r: 1 },
      { k: 'pb', t: 66, s: 40, rally: 1, d: 3, dl: -1, b: 90, sp: 1.1 }, { k: 'dancer', t: 78, s: 150, d: 14, dl: -8 }, { k: 'run12', t: 40, s: 74, d: 19, dl: -6 }]
  };
  var SB_KIND = { archer: 'hero', dancer: 'hero', mage: 'hero', knight: 'hero', run5: 'run', run8: 'run', run12: 'run', run5b: 'run' };
  var SBG = { page: null };
  function sbItem(o) {
    var kind = SB_KIND[o.k] || 'ball';
    var style = '--top:' + o.t + '%;--size:' + o.s + 'px;--dur:' + o.d + 's;--delay:' + (o.dl || 0) + 's;--bounce:' + (o.b || 0) + 'px;' +
      '--bdur:' + (o.bd || o.d) + 's;--sdur:' + (o.sp || 2) + 's';
    var y = kind === 'run' ? '' : kind === 'hero' ? (o.k === 'archer' ? 'sb-leap' : o.k === 'mage' ? 'sb-arc' : 'sb-bob')
      : (o.rally ? 'sb-hop' : (o.arc ? 'sb-arc' : 'sb-bounce'));
    return '<div class="sb sb-' + o.k + (o.r ? ' rev' : '') + (o.rally ? ' rally' : '') + (kind === 'hero' ? ' sb-hero' : kind === 'run' ? ' sb-runner' : '') +
      '" style="' + style + '"><div class="sb-x"><div class="sb-y ' + y + '"><div class="' + (kind === 'ball' ? 'sb-spin' : 'sb-flip') + '">' +
      SB_SVG[o.k] + '</div></div></div></div>';
  }
  function renderSportBg() {
    var el = document.getElementById('sport-bg');
    if (!el) return;
    var key = SPORT_BG[state.page] ? state.page : '';
    if (key === SBG.page) return;                  // same page: keep the animation running through data refreshes
    SBG.page = key;
    el.innerHTML = key ? SB_DEFS + SPORT_BG[key].map(sbItem).join('') : '';
  }

  function render() {
    if ($('#lb') && LB.page !== state.page) lbClose();
    if (state.page !== 'myreg') { MR.res = null; MR.err = ''; MR.notFound = false; MR.form = {}; MR.show = false; }   // leaving the page clears the runner's details
    if (state.page !== 'marshal' && CAM.on) camStop();
    document.body.classList.toggle('marshal-mode', state.page === 'marshal');
    document.body.classList.toggle('staff-only', STAFF_ONLY);
    document.body.classList.toggle('runner-mode', state.page === 'myreg');
    document.body.classList.toggle('board-mode', state.page === 'live' || state.page === 'kits' || state.page === 'podium' || state.page === 'clock');
    var see = state.page === 'overlay' || (state.page === 'clock' && !!clockBg());   // see-through page for OBS
    document.body.classList.toggle('overlay-mode', see);
    document.documentElement.classList.toggle('overlay-mode', see);
    renderNav();
    renderSportBg();
    var app = $('#app'), keep = $('#fb-live');
    var built = false;
    if (state.page === 'overlay' && $('#ov')) ovUpdate();      // the stream overlay updates in place: pop-ups and the moving line keep going
    else if (state.page === 'podium' && $('#awd')) podUpdate();   // the awarding screen keeps its place in the reveal
    else {
      built = true;
      var html = (VIEWS[state.page] || viewHome)();
      if (PAGES.some(function (x) { return x.id === state.page; })) html += photosSection(state.page);   // Site - Photos gallery
      if (keep && html.indexOf('id="fb-live" data-src="' + esc(keep.getAttribute('data-src')) + '"') !== -1) swapAroundVideo(app, keep, html);   // the video keeps playing
      else app.innerHTML = html;
    }
    renderFooter();
    tick();
    if (state.page === 'marshal') {
      var f = $('#m-bib') || $('#k-q');
      if (f) f.focus();
      keepAwake();
      if (CAM.on) { if ($('#cam-wrap')) camRender(); else camStop(); }
      if (M.scanBib && M.station && M.pin) {        // opened from a bib QR code on a staff phone
        var sb = M.scanBib, ty = stType(M.station), chk = M.scanCheck || '', sc = M.scanCode || '';
        M.scanBib = ''; M.scanCheck = ''; M.scanCode = '';
        if (ty === 'kit') { K.pendingCheck = chk; kitSearch(sb); }
        else if (ty === 'payment') { P.q = sb; var pq = $('#p-q'); if (pq) pq.value = sb; payRefresh(); }
        else if ($('#m-bib')) {
          if (chk === 'valid' && !recentlyRecorded(sb)) mRecord(sb, sc);            // scanned with the phone camera app: record now
          else if (chk === 'valid') { M.note = 'Bib ' + sb + ' was already recorded on this phone a moment ago.'; mRefresh(); }
          else if (chk === 'invalid') { M.note = '⚠️ That QR code is NOT valid for bib ' + sb + '. Nothing was recorded – check the bib and the runner.'; mRefresh(); }
          else $('#m-bib').value = sb;                                                // older QR without a security code: tap Confirm
        }
      }
    }
    if (state.page === 'qrcodes') drawQrs();
    hqStart();                                      // Race HQ ↔ marshals: pings, messages, the 💬 HQ button
    mbPrintStyle();                                 // own-design bibs: page size = bib size (removed on other pages)
    if (state.page === 'qrcodes' && B.layout === 'mine') setTimeout(mbFit, 50);
    if (state.page === 'live') keepAwake();
    if (state.page === 'kits') { keepAwake(); kbFit(); kbTurn(); }
    if (state.page === 'overlay') { keepAwake(); ovStart(); }
    if (state.page === 'podium') { keepAwake(); if (built) podStart(); }
    if (state.page === 'winners') refreshRace();
    if (state.page === 'clock') { keepAwake(); refreshRace(); clockTick(); }
    if (state.page === 'funrun') clockTick();
    if (state.page === 'live' || state.page === 'funrun') refreshRace();   // check for new check-ins right away
    if (state.page === 'funrun' && state.scrollToBib && $('#bib-sec')) { state.scrollToBib = false; ($('#bibq') || $('#bib-sec')).scrollIntoView({ block: 'center' }); }
  }

  function go(page) {
    if (!isPage(page)) page = 'home';
    if (STAFF_ONLY && STAFF_PAGES.indexOf(page) === -1) {
      if (page !== 'home') window.open(location.pathname.replace(/staff(\.html)?\/?$/i, '') + '?page=' + page, '_blank', 'noopener');
      return;                                       // the staff page stays on staff screens
    }
    if (DATA.light && page !== 'marshal' && page !== 'qrcodes' && hasGas()) {
      $('#app').innerHTML = '<section class="sec">' + empty('⏳', 'Loading the event website…') + '</section>';
      google.script.run.withSuccessHandler(function (txt) {
        try { DATA = JSON.parse(txt); } catch (err) { return; }
        go(page);
      }).withFailureHandler(function (err) {
        var why = navigator.onLine === false ? 'there is no internet connection on this device' : friendlyError(String((err && err.message) || err || ''));
        $('#app').innerHTML = '<section class="sec">' + empty('📶', 'Could not load the website: ' + esc(why) + '. Then try again.') + '</section>';
      })
        .getSiteData();
      return;
    }
    state.page = page;
    render();
    window.scrollTo(0, 0);
    try { google.script.history.push({ page: page }, { page: page }); } catch (e) {}
  }

  function tick() {
    var up = $('#updated');
    if (up) up.textContent = 'Updated ' + rel(DATA.checkedMs || DATA.generatedMs);
    if (state.page === 'funrun') clockStripRefresh();
    if (state.page === 'marshal') wlRefresh();
    var ku = $('#kb-upd');
    if (ku) ku.textContent = 'Updated ' + rel(DATA.checkedMs || DATA.generatedMs);
    var ru = $('#race-upd');
    if (ru && (raceActive() || state.page === 'live')) ru.textContent = raceUpdated();
    document.querySelectorAll('.bd-clock[data-gun]').forEach(function (el) {
      el.textContent = '⏱ ' + raceClock(nowSync() - Number(el.getAttribute('data-gun')));
    });
    document.querySelectorAll('.ov-clk[data-gun]').forEach(function (el) {
      el.textContent = raceClock(mNow() - Number(el.getAttribute('data-gun')));
    });
    var ov = $('#ov');
    if (ov) ov.classList.toggle('stale', hasGas() && Date.now() - (DATA.checkedMs || DATA.generatedMs || 0) > 20000);
    var mc = $('#m-clock');
    if (mc) mc.textContent = mClock(mNow());
    if (state.page === 'marshal' && M.station && M.pin && !CLK.busy && Date.now() - CLK.at > 600000 && Date.now() - CLK.tried > 30000) clockCheck(3);
    if (state.page === 'marshal' && M.queue.length && !M.sending && (M.offline || M.lastError)) mRefreshPending();
    var cd = $('#countdown');
    if (!cd || !DATA.info.countdownMs) return;
    var ms = DATA.info.countdownMs - Date.now();
    if (ms <= 0) { cd.innerHTML = '<div class="cd-done">🎉 It’s happening now — see you there!</div>'; return; }
    var s = Math.floor(ms / 1000), parts = [[Math.floor(s / 86400), 'days'], [Math.floor(s % 86400 / 3600), 'hrs'], [Math.floor(s % 3600 / 60), 'min'], [s % 60, 'sec']];
    cd.innerHTML = parts.map(function (p) { return '<div class="cd"><b>' + (p[1] === 'days' ? p[0] : ('0' + p[0]).slice(-2)) + '</b><small>' + p[1] + '</small></div>'; }).join('');
  }

  // ---------------- events ----------------
  document.addEventListener('click', function (e) {
    var t = e.target.closest('#updated, #race-upd, #kb-upd');
    if (t) { t.textContent = 'Checking…'; refreshData.busy = 0; refreshData(); refreshRace(true); return; }   // one tap: update now
    t = e.target.closest('[data-scrollto]');
    if (t) {                                       // e.g. "Watch live video": scroll to it, just below the menu bar
      e.preventDefault();
      var jump = document.getElementById(t.getAttribute('data-scrollto')), bar = $('.top');
      if (jump) window.scrollTo({ top: jump.getBoundingClientRect().top + window.scrollY - (bar ? bar.offsetHeight : 0) - 10, behavior: 'smooth' });
      return;
    }
    t = e.target.closest('[data-page]');
    if (t) { e.preventDefault(); go(t.getAttribute('data-page')); return; }
    t = e.target.closest('[data-runcat]');
    if (t) { state.runnerCat = t.getAttribute('data-runcat'); state.runnerLimit = 60; $('#runtabs').innerHTML = runTabs(); $('#runlist').innerHTML = runnerList(); return; }
    t = e.target.closest('[data-rescat]');
    if (t) { state.resultCat = t.getAttribute('data-rescat'); $('#results-sec').innerHTML = resultsSection(); return; }
    t = e.target.closest('[data-more]');
    if (t) { state.runnerLimit += 60; $('#runlist').innerHTML = runnerList(); return; }
    t = e.target.closest('[data-lane]');
    if (t) { var lk = t.getAttribute('data-lane'); TRK.open[lk] = !TRK.open[lk]; $('#trk-body').innerHTML = trackBody(); return; }
    t = e.target.closest('[data-mr="done"]');
    if (t) { MR.res = null; MR.err = ''; MR.notFound = false; MR.form = {}; MR.show = false; mrDraw(); window.scrollTo(0, 0); return; }   // Sign out
    if (e.target.id === 'mr-show') { MR.show = e.target.checked; var pin = $('#mr-pin'); if (pin) pin.type = MR.show ? 'text' : 'password'; }
    t = e.target.closest('[data-lb]');
    if (t) { var lbd = t.getAttribute('data-lb'); if (lbd === 'x') lbClose(); else { LB.i += Number(lbd); lbDraw(); } return; }
    if (e.target.id === 'lb') { lbClose(); return; }           // tap beside the photo: close
    t = e.target.closest('[data-photo]');
    if (t) { lbOpen(state.page, Number(t.getAttribute('data-photo'))); return; }
    t = e.target.closest('#awd');
    if (t) { podNext(); return; }                    // awarding screen: a click reveals the next place
    t = e.target.closest('[data-gunall]');
    if (t) { gunTapAll(); return; }
    t = e.target.closest('[data-gunstart]');
    if (t) { gunTap(t.getAttribute('data-gunstart')); return; }
    t = e.target.closest('[data-kbcat]');
    if (t) { KBD.cat = t.getAttribute('data-kbcat'); KBD.page = 0; $('#kb-tabs').innerHTML = kbTabs(); $('#kb-sum').innerHTML = kbSummary(); kbRedraw(); kbFit(); return; }
    t = e.target.closest('[data-trkcat]');
    if (t) { state.trackCat = t.getAttribute('data-trkcat'); $('#trk-tabs').innerHTML = trackTabs(); $('#trk-body').innerHTML = trackBody(); return; }
    t = e.target.closest('[data-pick]');
    if (t) {                                       // welcome screen, step 2: the chosen station with name + PIN
      M.pick = t.getAttribute('data-pick'); M.error = '';
      render();
      var sg = $('#wl-sign'); if (sg && sg.scrollIntoView) sg.scrollIntoView({ block: 'start' });
      var f = M.staff ? $('#m-pin') : $('#m-staff'); if (f) { try { f.focus({ preventScroll: true }); } catch (err) { f.focus(); } }
      return;
    }
    if (e.target.closest('[data-wl-ready]')) { var rc = $('#wl-readyc'); if (rc) rc.scrollIntoView({ block: 'start', behavior: 'smooth' }); return; }
    if (e.target.closest('[data-wl-back]')) { M.pick = ''; M.changing = true; M.error = ''; render(); window.scrollTo(0, 0); return; }
    t = e.target.closest('[data-wl-eye]');
    if (t) {
      var pf = $('#m-pin');
      if (pf) { var show = pf.type === 'password'; pf.type = show ? 'text' : 'password'; t.textContent = show ? 'Hide' : 'Show'; t.setAttribute('aria-label', show ? 'Hide the PIN' : 'Show the PIN'); }
      return;
    }
    t = e.target.closest('[data-undo]');
    if (t) { mUndo(t.getAttribute('data-undo')); return; }
    t = e.target.closest('[data-kpick]');
    if (t) {
      var kid = t.getAttribute('data-kpick');
      K.card = (K.res || []).filter(function (r) { return r.regId === kid; })[0] || null;
      K.ok = ''; K.confirmUnpaid = false; kitRefresh(); return;
    }
    t = e.target.closest('[data-krelease]');
    if (t) { kitRelease(t.getAttribute('data-krelease')); return; }
    t = e.target.closest('[data-kundo]');
    if (t) { kitUndo(t.getAttribute('data-kundo')); return; }
    t = e.target.closest('[data-ptab]');
    if (t) { P.tab = t.getAttribute('data-ptab'); payRefresh(); return; }
    t = e.target.closest('[data-pay]');
    if (t) { paySet(t); return; }
    t = e.target.closest('[data-prefresh]');
    if (t) { payLoad(); return; }
    t = e.target.closest('[data-qrcat]');
    if (t) { B.cat = t.getAttribute('data-qrcat'); render(); return; }
    t = e.target.closest('[data-blayout]');
    if (t) { B.layout = t.getAttribute('data-blayout'); render(); return; }
    t = e.target.closest('[data-mbreset]');
    if (t) {
      var def = JSON.parse(JSON.stringify(MB_DEFAULT));
      MB.f = def.f; MB.hide = def.hide; MB.white = def.white; MB.strip = def.strip; mbSave(); render(); return;
    }
    t = e.target.closest('[data-mbdel]');
    if (t) { mbRemove(t.getAttribute('data-mbdel')); return; }
    t = e.target.closest('[data-mbpreset]');
    if (t) { mbPresetStrip(); return; }
    t = e.target.closest('[data-mclear]');
    if (t) { mClear(t.getAttribute('data-mclear')); return; }
    t = e.target.closest('[data-sendnow]');
    if (t) { M.fails = 0; clearTimeout(M.retryTimer); mPump(); return; }
    t = e.target.closest('[data-cam]');
    if (t) { var ca = t.getAttribute('data-cam'); if (ca === 'start') camStart(); else if (ca === 'next') camResume(); else camStop(); return; }
    t = e.target.closest('[data-print]');
    if (t) { window.print(); return; }
    t = e.target.closest('[data-vplay]');
    if (t) { voxPlay(t.getAttribute('data-vplay'), false); return; }
    t = e.target.closest('[data-hq]');
    if (t) {
      var hqa = t.getAttribute('data-hq');
      if (hqa === 'open') { HQ.open = true; HQ.unread = 0; HQ.seen = HQ.last; HQ.banner = null; HQ.err = ''; hqSave(); hqDock(); var ri = $('#hq-rtext'); if (ri) ri.focus(); }
      else if (hqa === 'close') { HQ.open = false; hqDock(); }
      else if (hqa === 'ack') { HQ.banner = null; HQ.unread = 0; HQ.seen = HQ.last; hqSave(); hqDock(); hqSend('✅ OK, copy', 'HQ'); }
      return;
    }
    t = e.target.closest('[data-hqsay]');
    if (t) { hqSend(t.getAttribute('data-hqsay'), 'HQ'); return; }
    t = e.target.closest('[data-hqfill]');
    if (t) { var ht = $('#hq-text'); if (ht) { ht.value = t.getAttribute('data-hqfill'); HQ.draft = ht.value; ht.focus(); } return; }
    t = e.target.closest('[data-hqto]');
    if (t) { HQ.to = t.getAttribute('data-hqto'); var hs = $('#hq-to'); if (hs) hs.value = HQ.to; var hx = $('#hq-text'); if (hx) { hx.scrollIntoView({ block: 'center' }); hx.focus(); } return; }
    t = e.target.closest('[data-m="logout"]');
    if (t) {
      if (M.queue.length) { M.note = M.queue.length + ' check-in(s) still waiting to send. Stay on this station until they are sent.'; mRefresh(); return; }
      camStop(); M.pin = ''; M.pick = ''; M.station = null; M.error = ''; kitReset(); payReset(); B.data = null; B.msg = ''; hqReset(); mSave(); render();
    }
  });
  window.addEventListener('resize', function () {   // TV / window resized or phone turned: re-fit the kit board
    if (state.page !== 'kits') return;
    clearTimeout(KBD.rs);
    KBD.rs = setTimeout(function () { if (kbWide() !== KBD.wide) render(); else kbFit(); }, 250);
  });
  document.addEventListener('pointerdown', function (e) {   // 🎤 hold to talk
    var t = e.target.closest && e.target.closest('[data-vox]');
    if (!t) return;
    e.preventDefault();
    voxStart(t.getAttribute('data-vox') === 'hq' ? (($('#hq-to') || {}).value || 'All') : 'HQ');
  });
  document.addEventListener('contextmenu', function (e) { if (e.target.closest && e.target.closest('[data-vox]')) e.preventDefault(); });
  document.addEventListener('submit', function (e) {
    if (e.target.id === 'm-form') { e.preventDefault(); mSubmit(); }
    if (e.target.id === 'm-login') { e.preventDefault(); mLogin(); }
    if (e.target.id === 'k-form') { e.preventDefault(); kitSearch(($('#k-q') || {}).value); }
    if (e.target.id === 'mr-form') { e.preventDefault(); mrCheck(); }
    if (e.target.id === 'hq-reply') { e.preventDefault(); hqSend(($('#hq-rtext') || {}).value, 'HQ', function () { HQ.draft = ''; hqDock(); }); }
    if (e.target.id === 'hq-form') {
      e.preventDefault();
      hqSend(($('#hq-text') || {}).value, ($('#hq-to') || {}).value || 'All', function () { HQ.draft = ''; var x = $('#hq-text'); if (x) x.value = ''; });
    }
  });
  document.addEventListener('input', function (e) {
    if (e.target.id === 'bibq') { state.bibQuery = e.target.value; $('#bibres').innerHTML = bibResults(); }
    if (/^mr-(name|pin)$/.test(e.target.id)) MR.form[e.target.id] = e.target.value;
    if (e.target.id === 'hq-rtext' || e.target.id === 'hq-text') HQ.draft = e.target.value;
    if (e.target.id === 'hq-to') HQ.to = e.target.value;
    if (e.target.id === 'runq') { state.runnerQuery = e.target.value; state.runnerLimit = 60; $('#runlist').innerHTML = runnerList(); }
    if (e.target.id === 'kbq') { KBD.q = e.target.value; $('#kb-body').innerHTML = kbBody(); }
    if (e.target.id === 'trackq') { state.trackQuery = e.target.value; $('#trk-body').innerHTML = trackBody(); }
    if (e.target.id === 'm-bib') {                 // Bluetooth/USB scanner typed into the box: record it without Enter
      var lk = parseQrLink(e.target.value), now = Date.now(), v = e.target.value.trim();
      if (!v) BOX.first = 0; else if (!BOX.first) BOX.first = mNow();   // timed from the first character, not from Confirm
      if (lk && lk.code) { mSubmit(); return; }
      BOX.slow = v.length <= 1 ? false : (BOX.slow || now - BOX.last > 60);   // a person's taps are never this fast
      BOX.last = now;
      clearTimeout(BOX.timer);
      if (!BOX.slow && /^\d{3,6}$/.test(v)) BOX.timer = setTimeout(function () {
        var b = $('#m-bib');
        if (b && b.value.trim() === v) mSubmit();
      }, 300);
    }
    if (e.target.id === 'p-q') { P.q = e.target.value; $('#p-list').innerHTML = payList(); }
  });

  // ---------------- full refresh (on changes, plus every 5 minutes as a safety net) ----------------
  function refreshData() {
    if (!(window.google && google.script && google.script.run)) return;
    if (document.visibilityState === 'hidden') return;
    if (state.page === 'marshal' || state.page === 'qrcodes') return;   // staff screens don't need the website data
    if (refreshData.busy && Date.now() - refreshData.busy < 20000) return;   // already loading
    refreshData.busy = Date.now();
    lastFetch = Date.now();
    google.script.run.withSuccessHandler(function (txt) {
      refreshData.busy = 0;
      try { DATA = JSON.parse(txt); } catch (err) { return; }
      RP.ver = DATA.raceVer || ''; RP.site = DATA.siteVer || '';   // the live updates continue from this copy
      DATA.checkedMs = Date.now();
      if (KBD.prev) kbNoteChanges();
      if (state.page === 'marshal' || state.page === 'qrcodes') return;   // never redraw staff screens or the print sheet
      var a = document.activeElement, id = a && a.id, pos = a && a.selectionStart;
      var y = window.scrollY;
      render();
      window.scrollTo(0, y);
      if (id) {
        var el = document.getElementById(id);
        if (el) { el.focus({ preventScroll: true }); try { el.setSelectionRange(pos, pos); } catch (err) {} }
      }
    }).withFailureHandler(function () { refreshData.busy = 0; }).getSiteData();
  }
  setInterval(refreshData, 300000);
  refreshRace();                            // live race updates: every 3 s on race day (only downloads when something changed)
  setInterval(tick, 1000);
  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState !== 'visible') return;
    if (Date.now() - lastFetch > 300000) refreshData();
    refreshRace(); keepAwake(); mPump();
  });
  window.addEventListener('online', function () { M.fails = 0; clearTimeout(M.retryTimer); mPump(); });   // back online → send at once
  try {
    google.script.history.setChangeHandler(function (ev) {
      var p = (ev.state && ev.state.page) || (ev.location && ev.location.parameter && ev.location.parameter.page) || 'home';
      state.page = isPage(p) ? p : 'home';
      render();
    });
  } catch (e) {}

  mLoad();
  if (INITIAL_PAGE === 'scan') {               // opened from a bib QR code
    if (M.station && M.pin) { state.page = 'marshal'; M.scanBib = INITIAL_BIB; M.scanCheck = INITIAL_CHECK; M.scanCode = INITIAL_CODE; }
    else { state.page = 'funrun'; state.bibQuery = INITIAL_BIB; state.scrollToBib = true; state.scanBib = INITIAL_BIB; state.scanCheck = INITIAL_CHECK; }
  }
  render();
  mPump();
};
</script>
<script>
// ---------------- LOADER: connects this page to the spreadsheet (through Apps Script doPost) ----------------
(function () {
  'use strict';
  var KEY = 'paskoriyuhan-site-v2';                       // last copy, so the page opens instantly next time
  var STAFF_KEY = 'paskoriyuhan-staff-v1';                 // staff screens: station list + event name only (no runner data)
  try { localStorage.removeItem('paskoriyuhan-site-v1'); } catch (e) {}   // copies saved before runner names were hidden
  var q = new URLSearchParams(location.search);
  var bib = String(q.get('bib') || '').replace(/\D/g, '').replace(/^0+(?=\d)/, '').slice(0, 6);
  window.INITIAL_BIB = bib;                                // opened from a bib QR code
  window.INITIAL_CODE = String(q.get('c') || '').replace(/[^0-9a-f]/gi, '').slice(0, 10).toUpperCase();
  window.INITIAL_CHECK = '';
  // The staff page: the same file saved as staff.html (or staff/index.html) opens straight into staff check-in.
  var STAFF_ONLY = /(^|\/)staff(\.html|\/(index\.html)?)?$/i.test(location.pathname);
  window.STAFF_ONLY = STAFF_ONLY;
  var asked = String(q.get('page') || (STAFF_ONLY ? 'marshal' : 'home')).replace(/[^a-z]/g, '');
  if (STAFF_ONLY && asked !== 'qrcodes') asked = 'marshal';
  window.INITIAL_PAGE = bib ? 'scan' : asked;
  window.INITIAL_DATA = null;
  var connected = /^https:\/\/script\.google\.com\/.+\/exec$/.test(String(API_URL || '').trim());

  // google.script.run, as on the Apps Script website, sent to the web app's doPost
  function call(fn, args, ok, fail) {
    if (!connected) { fail(new Error('This website is not connected to the spreadsheet yet.')); return; }
    fetch(String(API_URL).trim(), { method: 'POST', body: JSON.stringify({ action: 'rpc', fn: fn, args: args }) })
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.text(); })
      .then(function (t) {
        var res;
        try { res = JSON.parse(t); } catch (e) {
          if (/function not found|doPost/i.test(t)) throw new Error('Unknown request (the script has no doPost)');
          throw new Error('access denied – the Apps Script link answered with a Google page instead of data');
        }
        if (!res || !res.ok) throw new Error((res && res.error) || 'The website did not answer properly');
        if (fn === 'getSiteData') { try { localStorage.setItem(KEY, res.value); } catch (e) {} }
        if (fn === 'getMarshalPageData') { try { localStorage.setItem(STAFF_KEY, res.value); } catch (e) {} }
        ok(res.value);
      })
      .catch(function (err) { fail(err); });
  }
  function runner() {
    var ok = function () {}, fail = function () {};
    var p = new Proxy({}, { get: function (t, k) {
      if (k === 'withSuccessHandler') return function (f) { ok = f || ok; return p; };
      if (k === 'withFailureHandler') return function (f) { fail = f || fail; return p; };
      if (k === 'withUserObject') return function () { return p; };
      return function () { call(String(k), Array.prototype.slice.call(arguments), ok, fail); };
    } });
    return p;
  }
  window.google = { script: {
    get run() { return runner(); },
    history: {
      push: function (st, params) {
        var u = new URLSearchParams();
        Object.keys(params || {}).forEach(function (k) { if (params[k] && !(k === 'page' && params[k] === 'home')) u.set(k, params[k]); });
        try { history.pushState(st || null, '', location.pathname + (String(u) ? '?' + u : '')); } catch (e) {}
      },
      setChangeHandler: function (fn) {
        window.addEventListener('popstate', function (e) {
          var p = {}; new URLSearchParams(location.search).forEach(function (v, k) { p[k] = v; });
          fn({ state: e.state, location: { parameter: p } });
        });
      }
    }
  } };

  // The live stream overlay (?page=overlay) in OBS: see-through from the start, so the camera is never covered
  var overlay = window.INITIAL_PAGE === 'overlay';
  if (overlay) { document.documentElement.classList.add('overlay-mode'); if (document.body) document.body.classList.add('overlay-mode'); }
  function show(html) {
    var a = document.getElementById('app');
    if (a) a.innerHTML = '<section class="sec"><div class="card empty">' + html + '</div></section>';
  }
  if (!connected) {
    show('<span class="big">🔌</span>This website is not connected to the spreadsheet yet.<br>Open <b>index.html</b> and paste your Apps Script web app link (it ends in <b>/exec</b>) into <b>API_URL</b> near the top.');
    return;
  }
  var started = false, data = null, waiting = 0;
  function start() {
    if (started || !data) return;
    started = true;
    window.INITIAL_DATA = data;
    try { if (data.info && data.info.eventName) document.title = data.info.eventName; } catch (e) {}
    try {                                                  // the logo as the browser-tab icon
      if (data.info && data.info.logo) {
        var ic = document.querySelector('link[rel="icon"]') || document.head.appendChild(document.createElement('link'));
        ic.rel = 'icon'; ic.href = data.info.logo;
      }
    } catch (e) {}
    window.__startApp();
  }
  function done() { if (--waiting <= 0) start(); }
  // What went wrong, in plain words, and how to fix it
  function reason(err) {
    var m = String((err && err.message) || err || '');
    if (navigator.onLine === false) return ['There is no internet connection on this device.', 'Connect to Wi-Fi or mobile data, then tap Try again.'];
    if (/unknown request/i.test(m)) return ['The spreadsheet link is still running an older version of the script.',
      'In Apps Script: paste the latest Website.gs, then Deploy → Manage deployments → ✏️ Edit → Version: New version → Deploy (do not use New deployment – that makes a different link). Then reload this page.'];
    if (/access denied|HTTP 40[13]/i.test(m)) return ['The spreadsheet link is not open to everyone.',
      'Apps Script → Deploy → Manage deployments → ✏️ Edit → Execute as: Me, Who has access: Anyone → Deploy.'];
    if (/HTTP 404/i.test(m)) return ['The spreadsheet link in this page does not exist.',
      'Copy the Web app link (ends in /exec) from Apps Script → Deploy → Manage deployments into API_URL near the top of index.html.'];
    if (/HTTP 5\d\d|server error|lock|timed? ?out|exceeded/i.test(m)) return ['Google’s server could not answer right now.', 'Wait a minute, then tap Try again.'];
    if (/failed to fetch|load failed|networkerror|network request failed/i.test(m)) return ['The spreadsheet link could not be reached.',
      'Open the link in API_URL (near the top of index.html) in a browser. If it shows the event website, wait a minute and try again. If Google shows a message instead, deploy a new version of the script (Deploy → Manage deployments → ✏️ Edit → New version).'];
    return ['The spreadsheet answered with an error.', ''];
  }
  var tries = 0, tick = null;
  function failed(err, secs) {
    var r = reason(err), det = String((err && err.message) || err || 'no answer').replace(/[<>&]/g, '');
    clearInterval(tick);
    if (overlay) {                                        // on the stream: a small note in the corner, not a full page
      var a = document.getElementById('app');
      if (a) a.innerHTML = '<div style="position:fixed;left:2.5vw;bottom:1.6vw;padding:.5vw 1vw;border-radius:.6vw;background:rgba(20,8,10,.88);' +
        'color:#fff;font:600 1.1vw/1.3 system-ui,sans-serif">● Live results not connected – trying again <span id="retry-in"></span>' +
        '<br><small style="opacity:.65;font-weight:400">Attempt ' + tries + ' · ' + det + '</small></div>';
    } else {
      show('<span class="big">📶</span><b>Could not load the event website.</b><br>' + r[0] + (r[1] ? '<br><br>' + r[1] : '') +
        '<br><br><button class="btn" type="button" onclick="location.reload()">Try again now</button>' +
        (secs ? '<br><small id="retry-wrap">Trying again by itself <span id="retry-in"></span></small>' : '') +
        '<br><small style="opacity:.6">Details: ' + det + (tries > 1 ? ' · attempt ' + tries : '') + '</small>');
    }
    if (!secs) return;
    var due = Date.now() + secs * 1000;
    var upd = function () { var el = document.getElementById('retry-in'); if (el) el.textContent = 'in ' + Math.max(0, Math.ceil((due - Date.now()) / 1000)) + ' s'; };
    upd(); tick = setInterval(upd, 1000);
  }
  var staff = window.INITIAL_PAGE === 'marshal' || (STAFF_ONLY && window.INITIAL_PAGE === 'qrcodes');
  var cached = null;
  try { cached = JSON.parse(localStorage.getItem(staff ? STAFF_KEY : KEY) || 'null'); } catch (e) {}
  if (bib) {                                               // check the bib's QR security code first
    waiting++;
    call('checkBibQr', [bib, window.INITIAL_CODE], function (v) { window.INITIAL_CHECK = v || ''; done(); }, function () { done(); });
  }
  if (cached && cached.info) {
    data = cached;                                         // open at once; live updates bring it up to date in seconds
    if (!waiting) start();
    if (staff) call('getMarshalPageData', [], function (txt) {   // staff screens: the fresh station list, a moment later
      try { var d = JSON.parse(txt); if (window.__staffFresh) window.__staffFresh(d); } catch (e) {}
    }, function () {});
  } else {
    waiting++;
    (function load() {                                     // a screen nobody touches (OBS, a TV board) heals by itself:
      call(staff ? 'getMarshalPageData' : 'getSiteData', [], function (txt) {   // tries again after 5 s, 10 s … then every 30 s
        try { data = JSON.parse(txt); } catch (e) { data = null; }
        if (data) { clearInterval(tick); done(); } else again();
      }, again);
      function again(err) {
        tries++;
        var secs = Math.min(30, 5 * tries);
        failed(err, secs);
        setTimeout(load, secs * 1000);
      }
    })();
  }
})();
</script>
</body>
</html>
