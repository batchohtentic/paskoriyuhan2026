      '<path d="M76 58H96L102 92L72 94Z" fill="#eef4ff"/><path d="M73 86L104 84L109 99L69 101Z" fill="#4b5fd6"/>' +
      '<path d="M90 94L104 108L100 124" stroke="#e9f2ff" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" fill="none"/>' +
