      '<path d="M94 50L112 50L124 48" stroke="' + SKIN + '" stroke-width="5" stroke-linecap="round" fill="none"/>' +
      '<path d="M124 12C147 33 147 65 124 86" stroke="#7fe3ff" stroke-width="10" opacity=".3" fill="none" stroke-linecap="round"/>' +
      '<path d="M124 12C147 33 147 65 124 86" stroke="#c4f6ff" stroke-width="3.5" fill="none" stroke-linecap="round"/>' +
      '<path d="M124 12L76 60L124 86" stroke="#e8fbff" stroke-width="1" fill="none"/><path d="M76 60L146 47" stroke="#e8fbff" stroke-width="2"/>' +
